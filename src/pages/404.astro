---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Capsure" noindex>
  <section class="section">
    <div class="wrap" style="max-width:720px">
      <h1 style="font-size:clamp(36px,6vw,56px)">That page went unanswered.</h1>
      <p style="color:var(--muted);margin-top:20px;font-size:18px">Unlike your enquiries will. The page you’re after doesn’t exist.</p>
      <p style="margin-top:32px"><a class="btn btn-primary" href="/">Go to the homepage</a></p>
    </div>
  </section>
</Base>
