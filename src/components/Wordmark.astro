---
// The Capsure wordmark: a "C" that almost closes around a dot (the lead,
// caught and held) next to the name. Pure SVG + text, no image file.
interface Props { size?: number; class?: string }
const { size = 28, class: className = '' } = Astro.props;
---
<span class={`wordmark ${className}`} style={`--wm:${size}px`}>
  <svg class="wordmark-mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
    <path d="M26 9.5A12 12 0 1 0 26 22.5" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <circle cx="16" cy="16" r="4.5" fill="var(--accent)" />
  </svg>
  <span class="wordmark-text">capsure</span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: calc(var(--wm) * 0.34); color: var(--text); }
  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--wm) * 0.93);
    letter-spacing: -0.03em;
    line-height: 1;
    padding-bottom: 0.06em;
  }
</style>
