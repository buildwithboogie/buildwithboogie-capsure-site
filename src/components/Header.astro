---
import Wordmark from './Wordmark.astro';
const links = [
  { href: '/#calculator', label: 'Calculator' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#packages', label: 'Prices' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="home-link" aria-label="Capsure, home"><Wordmark size={26} /></a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a href="/#get-audit" class="btn btn-primary header-cta">
      <span class="long">Get your Leak Audit</span><span class="short">Leak Audit</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(14, 17, 22, 0.86);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid rgba(41, 49, 60, 0.7);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 68px; }
  .home-link { text-decoration: none; display: inline-flex; padding: 6px 0; }
  nav { display: none; }
  nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; font-weight: 500; }
  nav a:hover { color: var(--text); }
  .header-cta { min-height: 44px; padding: 10px 16px; font-size: 15px; }
  .header-cta .long { display: none; }
  @media (min-width: 900px) {
    nav { display: block; }
    .header-cta .long { display: inline; }
    .header-cta .short { display: none; }
  }
</style>
